<Prior.Request
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://www.haad.ae/DataDictionary/CommonTypes/PriorRequest.xsd">
	<Header>
		<SenderID>TF001_Malaffi</SenderID>
		<ReceiverID>T001_Malaffi</ReceiverID>
		<TransactionDate>{{DATE(DD/MM/YYYY)}} 01:00</TransactionDate>
		<RecordCount>1</RecordCount>
		<DispositionFlag>PRODUCTION</DispositionFlag>
	</Header>
	<Authorization>
		<Type>Authorization</Type>
		<ID>{{VAR(facility_id).CUSTOM.get_random_facility_license()}}-{{VAR(prior_request_id).CUSTOM.generate_numbers_id()}}</ID>
		<MemberID>{{VAR.member_id}}</MemberID>
		<PayerID>T001_Malaffi</PayerID>
		<EmiratesIDNumber>111-1111-1111111-1</EmiratesIDNumber>
        <DateOrdered>{{DATE(DD/MM/YYYY)}}</DateOrdered>
		<Encounter>
			<FacilityID>{{VAR.facility_id}}</FacilityID>
			<Type>3</Type>
			<Start>{{DATE(DD/MM/YYYY)}} 16:43</Start>
            <End>{{DATE(DD/MM/YYYY)}} 23:43</End>
		</Encounter>
		<Diagnosis>
			<Type>Principal</Type>
			<Code>A00.0</Code>
            <DxInfo>
                <Type>ICD10-CM</Type>
                <Code>A00.1</Code>
            </DxInfo>
		</Diagnosis>
		<Activity>
			<ID>{{VAR(activity_id).CUSTOM.generate_numbers_id()}}</ID>
			<Start>{{DATE(DD/MM/YYYY)}} 16:43</Start>
			<Type>3</Type>
			<Code>{{VAR(activity_code).CUSTOM.get_random_consultation_tariff_code()}}</Code>
			<Quantity>1.006</Quantity>
			<Net>1500.002</Net>
            <OrderingClinician>{{VAR(clinician_license).CUSTOM.get_clinician_license_starting_with(! pharma, ! pharma, ! pharma)}}</OrderingClinician>
            <Clinician>{{VAR.clinician_license}}</Clinician>
			<Observation>
				<Type>LOINC</Type>
				<Code>{{VAR(observation_code).CUSTOM.get_random_loinc()}}</Code>
				<Value>8</Value>
				<ValueType>Qn</ValueType>
			</Observation>
		</Activity>
	</Authorization>
</Prior.Request>